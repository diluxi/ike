#!/usr/bin/env python3
# ike-fetch MAX_BYTES
#
# One link on stdin (one line), one answer on stdout. Either
#	ok JSON_LENGTH
# followed by JSON saying what the link is (its source, its author, what
# they said, in ikext, and each file's name, type and length), then each
# file's bytes in order; or
#	no REASON
# and nothing more. ike believes the JSON only in shape, and strips every
# file it brings as an upload (invariant 6).
#
# Invariant 7: it never connects to an address that is not public. It
# resolves each name itself, refuses loopback, private, link-local,
# CGNAT, ULA, multicast and reserved addresses, connects to the address
# it checked (no second lookup), checks again at every redirect, talks
# https to a site's own hosts only, and caps every response's size and
# time. IKE_FETCH_ALLOW (host:port, a test's own server, plain http) and
# IKE_FETCH_TWITTER (that server in place of X's endpoint) are for the
# suites alone; ike's module never sets them.
#
# Sites: twitter / x, as Danbooru reads a tweet (its original images or
# its best mp4, its text as the artist's commentary, its author), through
# the endpoint X's own embeds read, which needs no account.
import http.client
import ipaddress
import json
import math
import os
import re
import socket
import ssl
import sys
import time
import urllib.parse

TIMEOUT = 20
DEADLINE = time.monotonic() + 90
MAX_JSON = 4 * 1024 * 1024
MAX_REDIRECTS = 3


class No(Exception):
    pass


def allowed_test():
    # host:port pairs a test's own server answers on, over plain http
    given = os.environ.get("IKE_FETCH_ALLOW", "")
    return {p for p in given.split(",") if p}


def public(address):
    ip = ipaddress.ip_address(address)
    if isinstance(ip, ipaddress.IPv6Address) and ip.ipv4_mapped:
        ip = ip.ipv4_mapped
    return ip.is_global and not ip.is_multicast and not ip.is_reserved


def resolved(host, port):
    try:
        found = socket.getaddrinfo(host, port, proto=socket.IPPROTO_TCP)
    except OSError:
        raise No("unresolved")
    addresses = [info[4][0] for info in found]
    if not addresses:
        raise No("unresolved")
    # every address the name has must be public: else a name could point
    # at one of each, and a retry land on the other
    for a in addresses:
        if not public(a):
            raise No("not-public")
    return addresses[0]


class Pinned(http.client.HTTPSConnection):
    # connects to the address that was checked, says the name for tls
    def __init__(self, host, address, **kw):
        super().__init__(host, timeout=TIMEOUT, context=ssl.create_default_context(), **kw)
        self.address = address

    def connect(self):
        sock = socket.create_connection((self.address, self.port), timeout=TIMEOUT)
        self.sock = self._context.wrap_socket(sock, server_hostname=self.host)


class PinnedPlain(http.client.HTTPConnection):
    def __init__(self, host, address, **kw):
        super().__init__(host, timeout=TIMEOUT, **kw)
        self.address = address

    def connect(self):
        self.sock = socket.create_connection((self.address, self.port), timeout=TIMEOUT)


def get(url, hosts, limit):
    # the body of url, following at most a few redirects, each to one of
    # hosts and each checked again
    for _ in range(MAX_REDIRECTS + 1):
        if time.monotonic() > DEADLINE:
            raise No("too-slow")
        parts = urllib.parse.urlsplit(url)
        host = parts.hostname or ""
        port = parts.port
        test = f"{host}:{port}" in allowed_test()
        if parts.scheme == "https" and host in hosts and port in (None, 443):
            conn = Pinned(host, resolved(host, 443))
        elif parts.scheme == "http" and test:
            conn = PinnedPlain(f"{host}:{port}", host)
        else:
            raise No("not-allowed")
        path = parts.path or "/"
        if parts.query:
            path += "?" + parts.query
        try:
            conn.request("GET", path, headers={"User-Agent": "ike-fetch", "Accept": "*/*"})
            response = conn.getresponse()
            if response.status in (301, 302, 303, 307, 308):
                url = urllib.parse.urljoin(url, response.getheader("Location") or "")
                conn.close()
                continue
            if response.status != 200:
                raise No(f"http-{response.status}")
            length = response.getheader("Content-Length")
            if length and int(length) > limit:
                raise No("too-large")
            body = response.read(limit + 1)
            if len(body) > limit:
                raise No("too-large")
            return body, response.getheader("Content-Type") or ""
        except (OSError, http.client.HTTPException):
            raise No("unreachable")
        finally:
            conn.close()
    raise No("too-many-redirects")


# twitter / x ---------------------------------------------------------------

STATUS = re.compile(
    r"^https?://(?:www\.|mobile\.)?(?:twitter|x)\.com/(?:(\w{1,15})|i/web|i)/status(?:es)?/(\d{1,20})(?:[/?#].*)?$"
)
TWITTER_HOSTS = {"cdn.syndication.twimg.com", "pbs.twimg.com", "video.twimg.com"}


def syndication_token(tweet):
    # what X's embeds send with a tweet's id: (id / 1e15) * pi, in base 36,
    # its zeros and its point taken out
    n = (tweet / 1e15) * math.pi
    digits = "0123456789abcdefghijklmnopqrstuvwxyz"
    whole, fraction = int(n), n - int(n)
    text = ""
    while whole:
        text = digits[whole % 36] + text
        whole //= 36
    text = (text or "0") + "."
    for _ in range(12):
        fraction *= 36
        digit = int(fraction)
        text += digits[digit]
        fraction -= digit
    return re.sub(r"(0+|\.)", "", text)


def ikext_link(label, url):
    # "label":[url], as ikext writes a link; a label with a quote in it is
    # left as text, and the address after it
    if '"' in label:
        return f"{label} {url}"
    return f'"{label}":[{url}]'


def commentary(tweet):
    # the tweet's words as Danbooru keeps an artist's commentary: links
    # given back their addresses, hashtags and mentions made links, the
    # media's own link left out
    text = tweet.get("text") or ""
    entities = tweet.get("entities") or {}
    swaps = []
    for u in entities.get("urls") or []:
        swaps.append((u["indices"], u.get("expanded_url") or u.get("url")))
    for m in entities.get("media") or []:
        swaps.append((m["indices"], ""))
    for h in entities.get("hashtags") or []:
        tag = h["text"]
        swaps.append((h["indices"], ikext_link("#" + tag, "https://x.com/hashtag/" + urllib.parse.quote(tag))))
    for m in entities.get("user_mentions") or []:
        name = m["screen_name"]
        swaps.append((m["indices"], ikext_link("@" + name, "https://x.com/" + name)))
    # indices count code points
    chars = list(text)
    for (start, end), replacement in sorted(swaps, key=lambda s: s[0][0], reverse=True):
        chars[start:end] = list(replacement)
    said = "".join(chars).strip()
    return said.replace("&amp;", "&").replace("&lt;", "<").replace("&gt;", ">")


def twitter(match, limit):
    tweet_id = match.group(2)
    url = (
        "https://cdn.syndication.twimg.com/tweet-result?id="
        + tweet_id
        + "&token="
        + syndication_token(int(tweet_id))
        + "&lang=en"
    )
    if os.environ.get("IKE_FETCH_TWITTER"):
        # a test's own server in place of X's
        url = os.environ["IKE_FETCH_TWITTER"] + "/tweet-result?id=" + tweet_id
    body, _ = get(url, TWITTER_HOSTS, MAX_JSON)
    try:
        tweet = json.loads(body)
    except ValueError:
        raise No("unreadable")
    if not isinstance(tweet, dict) or tweet.get("__typename") not in ("Tweet", None) or "user" not in tweet:
        raise No("not-found")
    user = tweet["user"]
    name = user.get("screen_name") or ""
    files = []
    for media in tweet.get("mediaDetails") or []:
        if media.get("type") == "photo":
            base = media["media_url_https"]
            stem, _, ext = base.rpartition(".")
            files.append(f"{stem}?format={ext}&name=orig")
        elif media.get("type") in ("video", "animated_gif"):
            variants = [
                v for v in (media.get("video_info") or {}).get("variants") or []
                if v.get("content_type") == "video/mp4"
            ]
            if variants:
                best = max(variants, key=lambda v: v.get("bitrate") or 0)
                files.append(best["url"])
    if not files:
        raise No("no-media")
    fetched = []
    # each address as the tweet names it, checked as any other: X's own
    # hosts, or a test's own server
    for f in files:
        body, kind = get(f, TWITTER_HOSTS, limit)
        fetched.append((f, kind, body))
    return {
        "site": "twitter",
        "source": f"https://x.com/{name}/status/{tweet_id}",
        "artist": user.get("name") or name,
        "artist_url": f"https://x.com/{name}",
        "posted": tweet.get("created_at") or "",
        "commentary": commentary(tweet),
        "files": [{"url": f, "type": kind, "length": len(b)} for f, kind, b in fetched],
    }, [b for _, _, b in fetched]


SITES = [(STATUS, twitter)]


def main(limit):
    line = sys.stdin.buffer.readline(4097).decode("utf-8", "replace").strip()
    try:
        for pattern, site in SITES:
            match = pattern.match(line)
            if match:
                said, bodies = site(match, limit)
                break
        else:
            raise No("unknown-site")
    except No as no:
        sys.stdout.write(f"no {no}\n")
        return
    head = json.dumps(said, ensure_ascii=False).encode("utf-8")
    out = sys.stdout.buffer
    out.write(f"ok {len(head)}\n".encode())
    out.write(head)
    for b in bodies:
        out.write(b)
    out.flush()


if __name__ == "__main__":
    main(int(sys.argv[1]))
