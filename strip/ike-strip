#!/usr/bin/env bash
# ike-strip MAX_BYTES MAX_SIDE MAX_PIXELS THUMB [MAX_SECONDS]
#
# One upload on stdin, one answer on stdout. Either
#	ok TYPE WIDTH HEIGHT STORED_LENGTH THUMB_LENGTH TRAITS [INFO_LENGTH]
# (TRAITS: "audio" for a video with sound, "font" or "font,variable" for
# a font, else "-") followed by the stored bytes, the thumbnail's, and
# for a font what ike-font says of it (its family, axes and commentary;
# a font has no width or height, "-"), or
#	no REASON
# and nothing more. The stored bytes are the upload with its metadata
# stripped losslessly (hazards P4, P7), the colour profile and an animated
# PNG's frames kept; the thumbnail is made from them. A video (WebM, MP4)
# is remuxed without metadata, one video and one audio stream, chapters
# and data tracks dropped, never re-encoded; its thumbnail is its first
# frame. A font (TTF, OTF, WOFF, WOFF2) is sanitised by OTS, its name
# table cut by ike-font, and sanitised again; its thumbnail is a black F
# drawn in it on nothing (transparent), with no font but it to fall back
# on.
# Run in its own unit, never in ike's VM (invariant 6, hazard P1).
set -euo pipefail

max_bytes=$1
max_side=$2
max_pixels=$3
thumb=$4
max_seconds=${5:-600}

# libvips loads nothing it does not trust with hostile input
export VIPS_BLOCK_UNTRUSTED=1

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

no() {
	printf 'no %s\n' "$1"
	exit 0
}

head -c $((max_bytes + 1)) >"$work/in"
size=$(stat -c %s "$work/in")
[ "$size" -le "$max_bytes" ] || no too-large
[ "$size" -gt 0 ] || no empty

magic=$(head -c 12 "$work/in" | od -An -tx1 | tr -d ' \n')
case $magic in
ffd8ff*) type=jpeg ;;
89504e470d0a1a0a*) type=png ;;
52494646????????57454250) type=webp ;;
1a45dfa3*) type=webm ;;
00010000* | 74727565*) type=ttf ;;
4f54544f*) type=otf ;;
774f4646*) type=woff ;;
774f4632*) type=woff2 ;;
????????66747970*) type=mp4 ;;
*) no not-an-image ;;
esac

# a video: what ffprobe reads of it, then the streams copied as they are
video() {
	probe() {
		ffprobe -v error -select_streams "$2" -show_entries "$3" -of csv=p=0 "$1" 2>/dev/null | head -n1
	}
	vcodec=$(probe "$1" v:0 stream=codec_name) || no unreadable
	acodec=$(probe "$1" a:0 stream=codec_name) || acodec=
	w=$(probe "$1" v:0 stream=width) || no unreadable
	h=$(probe "$1" v:0 stream=height) || no unreadable
	seconds=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$1" 2>/dev/null) || no unreadable
	[ -n "$vcodec" ] && [ -n "$w" ] && [ -n "$h" ] || no unreadable
	case $type:$vcodec in
	webm:vp8 | webm:vp9 | webm:av1 | mp4:h264 | mp4:hevc | mp4:av1) ;;
	*) no unplayable ;;
	esac
	case $type:$acodec in
	*: | webm:opus | webm:vorbis | mp4:aac | mp4:mp3 | mp4:opus) ;;
	*) no unplayable ;;
	esac
	[ "$w" -le "$max_side" ] && [ "$h" -le "$max_side" ] || no too-large
	[ $((w * h)) -le "$max_pixels" ] || no too-large
	[ "${seconds%%.*}" -lt "$max_seconds" ] 2>/dev/null || no too-long
}

# a font: OTS first, which reads it as a browser would and refuses or
# repairs what it does not trust; what ike-font makes of that is checked
# again. the F is drawn by libvips with a fontconfig that knows no font
# but this one
if [ "$type" = ttf ] || [ "$type" = otf ] || [ "$type" = woff ] || [ "$type" = woff2 ]; then
	ots-sanitize "$work/in" "$work/sane" >/dev/null 2>&1 || no unreadable
	flavor=$type
	[ "$type" = ttf ] || [ "$type" = otf ] && flavor=sfnt
	ike-font "$work/in" "$work/sane" "$flavor" "$work/out" "$work/info" 2>/dev/null ||
		no unreadable
	ots-sanitize "$work/out" "$work/check" >/dev/null 2>&1 || no unreadable
	mkdir "$work/fc"
	printf '<?xml version="1.0"?>\n<fontconfig><cachedir>%s</cachedir></fontconfig>\n' \
		"$work/fc" >"$work/fonts.conf"
	FONTCONFIG_FILE="$work/fonts.conf" XDG_CACHE_HOME="$work/fc" HOME="$work" \
		vips text "$work/f.png" F --fontfile "$work/sane" --font "ike 160" --dpi 72 \
		2>/dev/null || no unreadable
	# the text's coverage is the alpha of a black image its size
	fw=$(vipsheader -f width "$work/f.png" 2>/dev/null) || no unreadable
	fh=$(vipsheader -f height "$work/f.png" 2>/dev/null) || no unreadable
	vips black "$work/k.png" "$fw" "$fh" 2>/dev/null || no unreadable
	vips bandjoin "$work/k.png $work/f.png" "$work/a.png" 2>/dev/null || no unreadable
	side=$((fw > fh ? fw : fh))
	side=$((side + side / 4))
	vips gravity "$work/a.png" "$work/s.png" centre "$side" "$side" \
		--extend background --background "0 0" 2>/dev/null || no unreadable
	vipsthumbnail "$work/s.png" --size "${thumb}x${thumb}" \
		-o "$work/thumb.webp[Q=80,strip]" 2>/dev/null || no unreadable
	traits=font
	grep -q '^axis' "$work/info" && traits=font,variable
	printf 'ok %s - - %s %s %s %s\n' "$type" \
		"$(stat -c %s "$work/out")" "$(stat -c %s "$work/thumb.webp")" "$traits" \
		"$(stat -c %s "$work/info")"
	cat "$work/out" "$work/thumb.webp" "$work/info"
	exit 0
fi

if [ "$type" = webm ] || [ "$type" = mp4 ]; then
	video "$work/in"
	# what an encoder wrote into an h264 stream about itself (SEI) goes too
	bsf=()
	[ "$vcodec" = h264 ] && bsf=(-bsf:v filter_units=remove_types=6)
	[ "$vcodec" = hevc ] && bsf=(-bsf:v filter_units=remove_types=39\|40)
	ffmpeg -v error -nostdin -i "$work/in" -map 0:v:0 -map '0:a:0?' \
		-map_metadata -1 -map_chapters -1 -c copy "${bsf[@]}" \
		-fflags +bitexact -flags:v +bitexact -flags:a +bitexact \
		-f "$type" "$work/out" 2>/dev/null || no unreadable
	video "$work/out"
	ffmpeg -v error -nostdin -i "$work/out" -frames:v 1 -f image2 "$work/first.png" 2>/dev/null ||
		no unreadable
	vipsthumbnail "$work/first.png" --size "${thumb}x${thumb}" \
		-o "$work/thumb.webp[Q=80,strip]" 2>/dev/null || no unreadable
	traits=-
	[ -n "$acodec" ] && traits=audio
	printf 'ok %s %s %s %s %s %s\n' "$type" "$w" "$h" \
		"$(stat -c %s "$work/out")" "$(stat -c %s "$work/thumb.webp")" "$traits"
	cat "$work/out" "$work/thumb.webp"
	exit 0
fi

# the header's word on size, before anything is decoded (hazard P2)
dimensions() {
	w=$(vipsheader -f width "$1" 2>/dev/null) || no unreadable
	h=$(vipsheader -f height "$1" 2>/dev/null) || no unreadable
	pages=$(vipsheader -f n-pages "$1" 2>/dev/null) || pages=1
	[ "$pages" = 1 ] || no animated
	[ "$w" -le "$max_side" ] && [ "$h" -le "$max_side" ] || no too-large
	[ $((w * h)) -le "$max_pixels" ] || no too-large
}
dimensions "$work/in"

case $type in
jpeg)
	# the scan and the colour profile, byte for byte; every other
	# marker goes, the orientation with them: the pixels are kept as
	# they were stored, not turned
	jpegtran -copy icc "$work/in" >"$work/out" 2>/dev/null || no unreadable
	;;
png | webp)
	ike-chunks <"$work/in" >"$work/out" 2>/dev/null || no unreadable
	;;
esac

# what is stored is what is measured, and decoded once whole: a file
# that does not make a thumbnail is not taken
dimensions "$work/out"
vipsthumbnail "$work/out" --size "${thumb}x${thumb}" \
	-o "$work/thumb.webp[Q=80,strip]" 2>/dev/null || no unreadable

printf 'ok %s %s %s %s %s -\n' "$type" "$w" "$h" \
	"$(stat -c %s "$work/out")" "$(stat -c %s "$work/thumb.webp")"
cat "$work/out" "$work/thumb.webp"
