#!/usr/bin/env python3
# ike-svg IN OUT
#
# An SVG made into what ike stores: what an allowlist keeps of it, and
# nothing else (invariant 11, hazard P3). Kept: SVG's own elements that
# draw, and their attributes that say how; links within the document
# (#id); style that names no outside address. Gone: scripts, foreign
# objects, event handlers, links out, other namespaces (an editor's,
# with its file names), comments, metadata, title and desc (an author's
# words), embedded images (their own metadata), and any DOCTYPE or
# entity, refused outright. Written the same for the same input.
import re
import sys
import xml.etree.ElementTree as ET

SVG = "http://www.w3.org/2000/svg"
XLINK = "http://www.w3.org/1999/xlink"

ELEMENTS = {
    "svg", "g", "defs", "symbol", "use", "switch",
    "path", "rect", "circle", "ellipse", "line", "polyline", "polygon",
    "text", "tspan", "textPath",
    "linearGradient", "radialGradient", "stop", "pattern",
    "clipPath", "mask", "marker",
    "filter", "feBlend", "feColorMatrix", "feComponentTransfer", "feComposite",
    "feConvolveMatrix", "feDiffuseLighting", "feDisplacementMap", "feDistantLight",
    "feDropShadow", "feFlood", "feFuncA", "feFuncB", "feFuncG", "feFuncR",
    "feGaussianBlur", "feMerge", "feMergeNode", "feMorphology", "feOffset",
    "fePointLight", "feSpecularLighting", "feSpotLight", "feTile", "feTurbulence",
}

ATTRIBUTES = {
    "id", "class", "x", "y", "x1", "y1", "x2", "y2", "cx", "cy", "r", "rx", "ry",
    "fx", "fy", "fr", "width", "height", "d", "points", "pathLength",
    "viewBox", "preserveAspectRatio", "transform", "version",
    "fill", "fill-opacity", "fill-rule", "stroke", "stroke-width", "stroke-opacity",
    "stroke-linecap", "stroke-linejoin", "stroke-miterlimit", "stroke-dasharray",
    "stroke-dashoffset", "opacity", "color", "display", "visibility", "overflow",
    "clip-path", "clip-rule", "mask", "filter", "marker-start", "marker-mid", "marker-end",
    "stop-color", "stop-opacity", "offset", "gradientUnits", "gradientTransform",
    "spreadMethod", "patternUnits", "patternContentUnits", "patternTransform",
    "clipPathUnits", "maskUnits", "maskContentUnits", "markerUnits", "markerWidth",
    "markerHeight", "refX", "refY", "orient", "filterUnits", "primitiveUnits",
    "in", "in2", "result", "mode", "type", "values", "operator", "k1", "k2", "k3", "k4",
    "stdDeviation", "dx", "dy", "flood-color", "flood-opacity", "lighting-color",
    "radius", "baseFrequency", "numOctaves", "seed", "stitchTiles", "scale",
    "xChannelSelector", "yChannelSelector", "tableValues", "slope", "intercept",
    "amplitude", "exponent", "kernelMatrix", "order", "divisor", "bias", "targetX",
    "targetY", "edgeMode", "preserveAlpha", "surfaceScale", "diffuseConstant",
    "specularConstant", "specularExponent", "azimuth", "elevation", "z",
    "pointsAtX", "pointsAtY", "pointsAtZ", "limitingConeAngle",
    "font-family", "font-size", "font-style", "font-weight", "font-variant",
    "text-anchor", "dominant-baseline", "alignment-baseline", "baseline-shift",
    "letter-spacing", "word-spacing", "text-decoration", "writing-mode",
    "lengthAdjust", "textLength", "rotate", "startOffset", "method", "spacing",
    "side", "mix-blend-mode", "isolation", "paint-order", "vector-effect",
    "shape-rendering", "text-rendering", "image-rendering", "color-interpolation",
    "color-interpolation-filters", "style",
}

# what a style may say: the attributes above, and no address but #id
STYLE = ATTRIBUTES - {"id", "class", "style", "d", "points", "viewBox", "transform"}


def local(value):
    # url(#id) is the only url a value may hold
    for found in re.findall(r"url\s*\(([^)]*)\)", value, re.I):
        if not found.strip().strip("'\"").startswith("#"):
            return False
    return not re.search(r"(@import|expression\s*\(|javascript:|\\\\)", value, re.I)


def styled(text):
    kept = []
    for declaration in text.split(";"):
        if ":" not in declaration:
            continue
        name, value = (p.strip() for p in declaration.split(":", 1))
        if name in STYLE and local(value) and "<" not in value and ">" not in value:
            kept.append(f"{name}:{value}")
    return ";".join(kept)


TEXT = ("text", "tspan", "textPath")


def name_of(element):
    tag = element.tag
    if isinstance(tag, str) and tag.startswith("{" + SVG + "}"):
        return tag[len(SVG) + 2:]
    return None


def clean(element):
    # the element as kept, or None; its words, if it is text, and those
    # after each kept child of a text element
    name = name_of(element)
    if name not in ELEMENTS:
        return None
    kept = ET.Element(element.tag)
    for attribute, value in element.attrib.items():
        if attribute in ("{" + XLINK + "}href", "href"):
            if re.fullmatch(r"#[A-Za-z0-9_.:-]+", value):
                kept.set("href", value)
        elif attribute == "style":
            value = styled(value)
            if value:
                kept.set("style", value)
        elif attribute in ATTRIBUTES and local(value):
            kept.set(attribute, value)
    if name in TEXT:
        kept.text = element.text
    for child in element:
        cleaned = clean(child)
        if cleaned is not None:
            if name in TEXT:
                cleaned.tail = child.tail
            kept.append(cleaned)
    return kept


def main(path, out):
    data = open(path, "rb").read()
    lowered = data.lower()
    if b"<!doctype" in lowered or b"<!entity" in lowered:
        sys.exit(1)
    root = ET.fromstring(data)
    if name_of(root) != "svg":
        sys.exit(1)
    kept = clean(root)
    ET.register_namespace("", SVG)
    text = ET.tostring(kept, encoding="unicode", short_empty_elements=True)
    with open(out, "w", encoding="utf-8") as f:
        f.write(text)
        f.write("\n")


if __name__ == "__main__":
    main(sys.argv[1], sys.argv[2])
