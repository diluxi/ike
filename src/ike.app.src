{application, ike, [
    {description, "imageboard, booru and wiki over one store"},
    {vsn, "0.0.0"},
    {registered, [ike_sup]},
    {mod, {ike_app, []}},
    {applications, [kernel, stdlib, crypto, cowboy, esqlite]},
    {env, [
        {listen, #{ip => {127, 0, 0, 1}, port => 8970}},
        {data_dir, <<"data">>}
    ]}
]}.
