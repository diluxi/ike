{minimum_otp_vsn, "29"}.

{erl_opts, [debug_info, warnings_as_errors, warn_missing_spec]}.

%% proper is only used by the tests. it is listed here and not under the
%% test profile because rebar.lock, which nix/hex.json is made from, only
%% covers the default profile; the release leaves it out all the same.
{deps, [
    {cowboy, "2.21.0"},
    {proper, "1.5.0"}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls
]}.

{ct_opts, [{sys_config, ["config/test.config"]}]}.

{shell, [{config, "config/sys.config"}, {apps, [ike]}]}.

{relx, [
    {release, {ike, "0.0.0"}, [ike, sasl]},
    {sys_config, "config/sys.config"},
    {vm_args, "config/vm.args"},
    {extended_start_script, false}
]}.

{profiles, [
    {prod, [{relx, [{mode, prod}]}]},
    {test, [{erl_opts, [nowarn_missing_spec]}]}
]}.
